content/assets/models/mod_mil_hut/
content/assets/models/mod_mil_hut_ruin/
# MG10 explosion pack: the supplied C4 model (c4-explosive.zip) has no licence: the bake stays local-only; the part-built box is the fallback
content/weapons/models/explosion_pack/
