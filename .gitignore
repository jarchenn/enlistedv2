# naming overrides stay local-only (committed: neutral ids, stand-in soldier bodies and guns)
content/weapons/local/
content/weapons/models/*_local/
content/characters/trooper_*.glb
content/characters/robot_*.glb
# NA1: the user's gasmask / robot animation exports on game bodies (clip licences not stated): the bakes stay local-only (Allied and SS: made by the user, committed)
content/characters/gasmask2_*.glb
content/characters/mech.glb


