# systemd unit for the Normandy Mapmaker rendezvous + relay server.
# Install: sudo cp rendezvous.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now rendezvous
# Expects /opt/nmk-rendezvous/rendezvous.py (and optionally rendezvous.conf next to it).
[Unit]
Description=Normandy Mapmaker rendezvous and relay server (UDP 27900)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -u /opt/nmk-rendezvous/rendezvous.py --conf /opt/nmk-rendezvous/rendezvous.conf
Restart=always
RestartSec=2
# run as a throwaway unprivileged user with a read-only view of the system
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=16

[Install]
WantedBy=multi-user.target
